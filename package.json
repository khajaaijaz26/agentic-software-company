{
  "name": "software-agent",
  "version": "0.3.2",
  "description": "A visible, governed team of AI software agents in your terminal",
  "type": "module",
  "license": "Apache-2.0",
  "author": "khajaaijaz26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khajaaijaz26/software-agent.git"
  },
  "homepage": "https://github.com/khajaaijaz26/software-agent#readme",
  "bugs": {
    "url": "https://github.com/khajaaijaz26/software-agent/issues"
  },
  "keywords": ["ai", "agents", "multi-agent", "cli", "terminal", "coding-agent", "software-development"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "software-agent": "dist/cli.js",
    "agent-company": "dist/compat-agent-company.js"
  },
  "files": [
    "dist/",
    "assets/",
    "prompts/",
    "schemas/",
    "workflows/",
    "docs/",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "logo:render": "node scripts/render-logo.mjs",
    "prepack": "npm run check && npm run logo:render"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "ink": "^6.3.1",
    "react": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "eslint": "^9.34.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
