{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khajaaijaz26/software-agent/schemas/result-envelope.schema.json",
  "title": "Result Envelope (canonical)",
  "description": "Canonical result-envelope schema. The working copy used by the orchestrator lives at prompts/templates/result-envelope.json.",
  "type": "object",
  "required": [
    "envelope_version",
    "task_id",
    "correlation_id",
    "project_id",
    "agent_role",
    "status",
    "summary",
    "evidence",
    "artifacts",
    "budget_used",
    "next"
  ],
  "properties": {
    "envelope_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "BLOCKED", "NEEDS_APPROVAL", "NEEDS_INPUT", "ESCALATED"]
    },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "budget_used": {
      "type": "object",
      "properties": {
        "cost": { "type": "number", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "time_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "next": {
      "type": "object",
      "required": ["owner", "action"],
      "properties": {
        "owner": { "type": "string" },
        "action": { "type": "string" }
      }
    }
  }
}
