{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/model-descriptor.schema.json",
  "title": "Software Agent discovered model descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerId", "modelId", "capabilities", "pricing", "catalog"],
  "properties": {
    "providerId": { "$ref": "model-catalog.schema.json#/$defs/providerId" },
    "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "capabilities": { "$ref": "model-catalog.schema.json#/$defs/capabilities" },
    "pricing": {
      "oneOf": [
        { "$ref": "model-catalog.schema.json#/$defs/pricing" },
        { "const": "UNKNOWN" }
      ]
    },
    "catalog": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source", "observedAt"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        },
        { "const": "UNKNOWN" }
      ]
    }
  }
}
