{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/snapshot.schema.json",
  "title": "Software Agent authoritative snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cursor", "projectId", "projectName", "generatedAt", "mutationLease", "runs", "tokenBudgets", "recentEvents"],
  "properties": {
    "schema": { "const": "software-agent.snapshot/v2" },
    "cursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "projectId": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mutationLease": {
      "oneOf": [
        { "$ref": "mutation-lease.schema.json" },
        { "type": "null" }
      ]
    },
    "runs": { "type": "array", "items": { "$ref": "run.schema.json" } },
    "tokenBudgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/tokenBudgetView" }
    },
    "recentEvents": {
      "description": "The shared store can return explicit legacy events that predate runtime v2.",
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "event.schema.json" },
          { "$ref": "legacy-event.schema.json" }
        ]
      }
    }
  },
  "$defs": {
    "tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "tokenBudgetView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "mode", "fullLimitTokens", "effectiveLimitTokens", "spentTokens", "reservedTokens", "uncertainTokens", "remainingTokens", "warning", "blocked", "agents"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["economy", "balanced", "quality"] },
        "fullLimitTokens": { "$ref": "#/$defs/tokens" },
        "effectiveLimitTokens": { "$ref": "#/$defs/tokens" },
        "spentTokens": { "$ref": "#/$defs/tokens" },
        "reservedTokens": { "$ref": "#/$defs/tokens" },
        "uncertainTokens": { "$ref": "#/$defs/tokens" },
        "remainingTokens": { "$ref": "#/$defs/tokens" },
        "warning": { "type": "boolean" },
        "blocked": { "type": "boolean" },
        "agents": {
          "type": "array",
          "items": { "$ref": "token-allocation.schema.json" }
        }
      }
    }
  }
}
