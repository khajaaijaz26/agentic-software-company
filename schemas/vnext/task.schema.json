{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/task.schema.json",
  "title": "Software Agent runtime task view v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "role",
    "dependsOn",
    "mutatesWorkspace",
    "state",
    "revision",
    "sessionId",
    "summary"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "role": { "enum": ["master-orchestrator", "software-engineer", "reviewer-qa"] },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "uniqueItems": true
    },
    "mutatesWorkspace": { "type": "boolean" },
    "state": { "enum": ["BLOCKED", "READY", "RUNNING", "PASSED", "FAILED", "CANCELED"] },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "interaction": { "enum": ["workflow", "conversation"] },
    "instructionId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "activeTurnId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "summary": { "type": "string" }
  }
}
