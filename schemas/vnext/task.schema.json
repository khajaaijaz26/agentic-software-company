{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-company.dev/vnext/task.schema.json",
  "title": "Agent Company task view v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "role", "dependsOn", "state", "summary"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "PROPOSED",
        "BLOCKED",
        "READY",
        "CLAIMED",
        "RUNNING",
        "WAITING_TOOL",
        "WAITING_INPUT",
        "WAITING_APPROVAL",
        "REVIEW",
        "REWORK",
        "PASSED",
        "FAILED",
        "SKIPPED",
        "CANCELED"
      ]
    },
    "summary": { "type": "string" }
  }
}
