{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/event.schema.json",
  "title": "Software Agent runtime event v2",
  "description": "Current runtime event inside the append-only StoredEvent envelope. Event-specific data remains an open JSON object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "streamId",
    "eventType",
    "occurredAt",
    "actor",
    "data",
    "metadata",
    "sequence",
    "streamVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "eventType": {
      "type": "string",
      "pattern": "^software-agent\\.[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/actor" },
    "data": { "type": "object" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "streamVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "agent", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "correlationId", "causationId"],
      "properties": {
        "schema": { "const": "software-agent.event/v2" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "causationId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
