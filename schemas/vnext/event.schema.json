{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-company.dev/vnext/event.schema.json",
  "title": "Agent Company stored event v1",
  "description": "Append-only event envelope persisted by the vNext SQLite event store. Event-type payloads are validated by their own contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "streamId",
    "eventType",
    "occurredAt",
    "actor",
    "data",
    "sequence",
    "streamVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/actor" },
    "data": { "type": "object" },
    "metadata": { "type": "object" },
    "sequence": { "type": "integer", "minimum": 1 },
    "streamVersion": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "agent", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
