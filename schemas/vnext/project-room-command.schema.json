{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/project-room-command.schema.json",
  "title": "Software Agent project-room intent",
  "description": "Typed UI intent passed to an injectable ProjectRoomSource. It is not an IPC request until an adapter binds it to controller revisions, leases, and methods.",
  "oneOf": [
    { "$ref": "#/$defs/objective" },
    { "$ref": "#/$defs/instruction" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/providerConnect" },
    { "$ref": "#/$defs/providerTest" },
    { "$ref": "#/$defs/providerRemove" },
    { "$ref": "#/$defs/modelSelect" },
    { "$ref": "#/$defs/tokenMode" },
    { "$ref": "#/$defs/leave" }
  ],
  "$defs": {
    "cursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "expectedCursor"],
      "properties": {
        "type": { "const": "objective.create" },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "enum": ["agent", "task", "run"] },
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "runId", "text", "target", "expectedCursor"],
      "properties": {
        "type": { "const": "instruction.submit" },
        "runId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "target": { "$ref": "#/$defs/target" },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "approvalId", "decision", "expectedCursor"],
      "properties": {
        "type": { "const": "approval.decide" },
        "approvalId": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["APPROVED", "DENIED", "CHANGES_REQUESTED"] },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "providerConnect": {
      "type": "object",
      "description": "Ephemeral in-process intent. The secret must be consumed by a secure credential backend and must never become an IPC or event payload.",
      "additionalProperties": false,
      "required": ["type", "providerId", "model", "secret", "expectedCursor"],
      "properties": {
        "type": { "const": "provider.connect" },
        "providerId": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "secret": { "type": "string", "minLength": 8, "maxLength": 4096 },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "providerTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "providerId", "expectedCursor"],
      "properties": {
        "type": { "const": "provider.test" },
        "providerId": { "enum": ["openai", "anthropic"] },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "providerRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "providerId", "expectedCursor"],
      "properties": {
        "type": { "const": "provider.remove" },
        "providerId": { "enum": ["openai", "anthropic"] },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "modelSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "model", "expectedCursor"],
      "properties": {
        "type": { "const": "model.select" },
        "model": { "type": "string", "minLength": 3, "maxLength": 256 },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "tokenMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "expectedCursor"],
      "properties": {
        "type": { "const": "tokens.mode" },
        "mode": { "enum": ["economy", "balanced", "quality"] },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "leave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "disposition", "expectedCursor"],
      "properties": {
        "type": { "const": "session.leave" },
        "disposition": { "enum": ["continue", "pause", "cancel"] },
        "expectedCursor": { "$ref": "#/$defs/cursor" }
      }
    }
  }
}
