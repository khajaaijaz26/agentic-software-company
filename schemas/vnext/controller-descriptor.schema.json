{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/controller-descriptor.schema.json",
  "title": "Software Agent controller descriptor v2",
  "description": "Current discovery descriptor atomically emitted by a Software Agent controller. The nonce value is stored separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pid",
    "startedAt",
    "heartbeatAt",
    "endpoint",
    "transport",
    "instanceId",
    "protocol",
    "buildVersion",
    "userBinding",
    "nonceRef",
    "workspaceHash"
  ],
  "properties": {
    "schema": { "const": "software-agent.controller/v2" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "startedAt": { "type": "string", "format": "date-time" },
    "heartbeatAt": { "type": "string", "format": "date-time" },
    "endpoint": { "type": "string", "minLength": 1, "maxLength": 512 },
    "transport": { "enum": ["unix", "named-pipe"] },
    "instanceId": { "type": "string", "pattern": "^ctl_[a-f0-9]{32}$" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "const": 1 },
        "max": { "const": 2 }
      }
    },
    "buildVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "userBinding": { "type": "string", "pattern": "^[a-f0-9]{48}$" },
    "nonceRef": {
      "description": "Safe basename bound to instanceId; the descriptor never contains the nonce value.",
      "type": "string",
      "pattern": "^nonce-ctl_[a-f0-9]{32}\\.key$"
    },
    "workspaceHash": { "type": "string", "pattern": "^[a-f0-9]{24}$" }
  }
}
