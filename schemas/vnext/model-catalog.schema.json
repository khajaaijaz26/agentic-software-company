{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/model-catalog.schema.json",
  "title": "Software Agent model capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "providerId", "version", "source", "observedAt", "models"],
  "properties": {
    "schema": { "const": "software-agent.model-catalog/v1" },
    "providerId": { "$ref": "#/$defs/providerId" },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "models": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "knownOrNumber": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "UNKNOWN" }
      ]
    },
    "knownOrBoolean": {
      "oneOf": [
        { "type": "boolean" },
        { "const": "UNKNOWN" }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "structuredOutput", "vision", "streaming", "contextTokens"],
      "properties": {
        "tools": { "$ref": "#/$defs/knownOrBoolean" },
        "structuredOutput": { "$ref": "#/$defs/knownOrBoolean" },
        "vision": { "$ref": "#/$defs/knownOrBoolean" },
        "streaming": { "$ref": "#/$defs/knownOrBoolean" },
        "contextTokens": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "UNKNOWN" }
          ]
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "inputUsdPerMillionTokens", "cachedInputUsdPerMillionTokens", "outputUsdPerMillionTokens"],
      "properties": {
        "currency": { "const": "USD" },
        "inputUsdPerMillionTokens": { "$ref": "#/$defs/knownOrNumber" },
        "cachedInputUsdPerMillionTokens": { "$ref": "#/$defs/knownOrNumber" },
        "outputUsdPerMillionTokens": { "$ref": "#/$defs/knownOrNumber" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "capabilities", "pricing"],
      "properties": {
        "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "pricing": {
          "oneOf": [
            { "$ref": "#/$defs/pricing" },
            { "const": "UNKNOWN" }
          ]
        }
      }
    }
  }
}
