{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/step-frame.schema.json",
  "title": "Software Agent bound worker step frame v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/accepted" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/activity" },
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/completed" }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["schema", "runId", "taskId", "taskRevision", "sessionId", "turnId", "turnRevision", "attemptId", "leaseId", "fencingEpoch"],
      "properties": {
        "schema": { "const": "software-agent.step-frame/v1" },
        "runId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "taskId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "taskRevision": { "$ref": "step-manifest.schema.json#/$defs/revision" },
        "sessionId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "turnId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "turnRevision": { "$ref": "step-manifest.schema.json#/$defs/revision" },
        "attemptId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "leaseId": { "$ref": "step-manifest.schema.json#/$defs/id" },
        "fencingEpoch": { "$ref": "step-manifest.schema.json#/$defs/revision" }
      }
    },
    "hello": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "type": "object", "required": ["kind", "pid"], "properties": { "kind": { "const": "worker.hello" }, "pid": { "type": "integer", "minimum": 1 } } }
      ],
      "unevaluatedProperties": false
    },
    "accepted": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "type": "object", "required": ["kind", "at"], "properties": { "kind": { "const": "worker.accepted" }, "at": { "type": "string", "format": "date-time" } } }
      ],
      "unevaluatedProperties": false
    },
    "heartbeat": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "type": "object", "required": ["kind", "at"], "properties": { "kind": { "const": "worker.heartbeat" }, "at": { "type": "string", "format": "date-time" } } }
      ],
      "unevaluatedProperties": false
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningTokens", "totalTokens", "source"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/knownOrUnknown" },
        "outputTokens": { "$ref": "#/$defs/knownOrUnknown" },
        "cachedInputTokens": { "$ref": "#/$defs/knownOrUnknown" },
        "reasoningTokens": { "$ref": "#/$defs/knownOrUnknown" },
        "totalTokens": { "$ref": "#/$defs/knownOrUnknown" },
        "source": { "enum": ["PROVIDER", "UNKNOWN"] }
      }
    },
    "knownOrUnknown": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "const": "UNKNOWN" }
      ]
    },
    "activity": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": ["kind", "at", "activity"],
          "properties": {
            "kind": { "const": "worker.activity" },
            "at": { "type": "string", "format": "date-time" },
            "activity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "summary"],
              "properties": {
                "type": { "enum": ["model.started", "model.completed", "tool.started", "tool.completed", "tool.failed"] },
                "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
                "providerId": { "type": "string", "minLength": 1, "maxLength": 64 },
                "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
                "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
                "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "usage": { "$ref": "#/$defs/usage" },
                "costUsd": {
                  "oneOf": [
                    { "type": "number", "minimum": 0 },
                    { "const": "UNKNOWN" }
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "intent": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": ["kind", "intent"],
          "properties": {
            "kind": { "const": "worker.intent" },
            "intent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "summary"],
              "properties": {
                "type": { "const": "evidence" },
                "summary": { "type": "string", "minLength": 1, "maxLength": 16384 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "completed": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": ["kind", "at", "summary"],
          "properties": {
            "kind": { "const": "worker.completed" },
            "at": { "type": "string", "format": "date-time" },
            "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "providerId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "usage": { "$ref": "#/$defs/usage" },
            "costUsd": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                { "const": "UNKNOWN" }
              ]
            },
            "toolsUsed": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "filesChanged": { "type": "array", "maxItems": 512, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
