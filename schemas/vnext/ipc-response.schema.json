{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/ipc-response.schema.json",
  "title": "Software Agent authenticated controller RPC response",
  "description": "Correlated method-specific RPC result or error carried in a four-byte big-endian length-prefixed UTF-8 JSON frame. The response does not repeat the negotiated protocol version or request method.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "requestId", "ok"],
  "properties": {
    "kind": { "const": "response" },
    "requestId": { "type": "string", "pattern": "^rpc_[a-f0-9]{32}$" },
    "ok": { "type": "boolean" },
    "result": true,
    "error": { "$ref": "#/$defs/error" }
  },
  "oneOf": [
    {
      "required": ["result"],
      "properties": { "ok": { "const": true } },
      "not": { "required": ["error"] }
    },
    {
      "required": ["error"],
      "properties": { "ok": { "const": false } },
      "not": { "required": ["result"] }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
