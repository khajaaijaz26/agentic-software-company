{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-agent.dev/vnext/project-room.schema.json",
  "title": "Software Agent project-room snapshot v1",
  "description": "UI projection consumed by the reducer-driven Ink project room. This is an adapter contract, not the controller snapshot wire shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projectId", "projectName", "branch", "generatedAt", "cursor", "controller", "roster", "settings", "run", "approvals", "importantEvents"],
  "properties": {
    "schema": { "const": "software-agent.project-room/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "branch": { "type": "string" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mode"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["CONTROL", "READ_ONLY"] }
      }
    },
    "roster": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "$ref": "#/$defs/rosterAgent" } },
    "settings": { "$ref": "#/$defs/settings" },
    "run": {
      "oneOf": [
        { "$ref": "#/$defs/run" },
        { "type": "null" }
      ]
    },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "importantEvents": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "cursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "tokenCount": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "UNKNOWN" }
      ]
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cached", "reasoning"],
      "properties": {
        "input": { "$ref": "#/$defs/tokenCount" },
        "output": { "$ref": "#/$defs/tokenCount" },
        "cached": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "displayName", "state", "taskId", "taskTitle", "activity", "activitySince",
        "lastEventAt", "provider", "model", "tokens", "costUsd", "blocker", "approvalId",
        "requestedFiles", "requestedTools", "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "activity": { "type": "string" },
        "activitySince": { "$ref": "#/$defs/nullableTimestamp" },
        "lastEventAt": { "$ref": "#/$defs/nullableTimestamp" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "tokens": { "$ref": "#/$defs/tokenUsage" },
        "costUsd": { "$ref": "#/$defs/tokenCount" },
        "blocker": { "type": ["string", "null"] },
        "approvalId": { "type": ["string", "null"] },
        "requestedFiles": { "type": "array", "items": { "type": "string" } },
        "requestedTools": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rosterAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "capabilities", "state", "status", "activity", "taskTitle", "sessionId", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "state": { "enum": ["WORKING", "WAITING", "BLOCKED", "DONE", "FAILED"] },
        "status": { "type": "string", "minLength": 1 },
        "activity": { "type": "string" },
        "taskTitle": { "type": "string" },
        "sessionId": { "type": ["string", "null"] },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "defaultModel", "tokenMode", "providers"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "defaultModel": { "type": "string", "minLength": 1 },
        "tokenMode": { "enum": ["economy", "balanced", "quality"] },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providerId", "enabled", "model", "credentialReference"],
            "properties": {
              "providerId": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "model": { "type": "string", "minLength": 1 },
              "credentialReference": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "agentId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "state": { "type": "string", "minLength": 1 },
        "agentId": { "type": ["string", "null"] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "state", "startedAt", "agents", "tasks", "tokens", "costUsd", "tokenBudget"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "tokens": { "$ref": "#/$defs/tokenUsage" },
        "costUsd": { "$ref": "#/$defs/tokenCount" },
        "tokenBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "limit"],
          "properties": {
            "used": { "type": "number", "minimum": 0 },
            "limit": { "$ref": "#/$defs/tokenCount" }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "risk", "title", "purpose", "action", "resource", "exactPreview", "impact", "expiresAt", "agentId", "taskId", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "exactPreview": { "type": "string" },
        "impact": { "type": "string" },
        "expiresAt": { "type": "string" },
        "agentId": { "type": ["string", "null"] },
        "taskId": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "eventId", "occurredAt", "type", "severity", "summary", "agentId", "taskId", "approvalId"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "eventId": { "type": "string", "minLength": 1 },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "type": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["DEBUG", "INFO", "WARN", "ERROR", "CRITICAL"] },
        "summary": { "type": "string" },
        "agentId": { "type": ["string", "null"] },
        "taskId": { "type": ["string", "null"] },
        "approvalId": { "type": ["string", "null"] }
      }
    }
  }
}
